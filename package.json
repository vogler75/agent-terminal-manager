{
  "name": "agent-terminal-manager",
  "productName": "Agent Terminal Manager",
  "version": "0.1.0",
  "description": "Manage parallel AI agents across projects and terminals",
  "main": "src/main/main.js",
  "author": "Andreas Vogler",
  "license": "MIT",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.js",
    "start": "npm run build:renderer && electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "e2e": "npm run build:renderer && node test-e2e/run.js",
    "dist": "npm run build:renderer && electron-builder",
    "dist:win": "npm run build:renderer && electron-builder --win",
    "dist:mac": "npm run build:renderer && electron-builder --mac"
  },
  "build": {
    "appId": "com.vogler.agent-terminal-manager",
    "files": [
      "src/**/*",
      "dist/**/*",
      "package.json",
      "!dist/*.map"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "dist/atm-mcp-stdio.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "npmRebuild": false,
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "electron@45.1.0": true
  }
}
